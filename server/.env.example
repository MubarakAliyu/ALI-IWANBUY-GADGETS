# ALI_IWANBUY Gadgets — API environment
# Copy to server/.env and fill in. The server parses this at boot and refuses to start if anything is missing
# or malformed, naming the variable.

# development | test | production
NODE_ENV=development

# Port the API listens on. The Next.js app proxies /api to it.
PORT=4000

# MongoDB connection string. Transactions need a replica set (ADR-005):
#   • `pnpm db:local` prints a ready-made local URI (no MongoDB install needed)
#   • MongoDB Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27027/aib_store?replicaSet=aibrs&directConnection=true

# Database name used on that connection.
MONGODB_DB_NAME=aib_store

# The one browser origin allowed to call this API with cookies.
CLIENT_ORIGIN=http://localhost:3000

# Session signing keys, one per realm. At least 24 characters each. The value below is a development
# placeholder — generate your own before deploying anything:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_JWT_SECRET=development-customer-secret-change-me
ADMIN_JWT_SECRET=development-admin-secret-change-me

# Where product images are written and served from. `local` writes under server/uploads and serves /uploads.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Outgoing email (used from Batch 2). With no SMTP host the mailer writes messages to server/.local/outbox.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ALI_IWANBUY Gadgets <no-reply@aliiwanbuy.com>

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Production only (Batch 3 Part H.1) ────────────────────────────────────────────────────────────────
# Render's disk does not survive a deploy, so uploads go to a CDN there. Locally, leave STORAGE_PROVIDER as
# `local` above and leave this empty.
#   STORAGE_PROVIDER=cloudinary
#   CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# How the auth cookies are scoped. Leave as `lax`: in production the browser only talks to the Vercel domain,
# which rewrites /api/* to this service, so the cookies stay first-party. Set `none` ONLY if the dashboard and
# the API are on different domains with no proxy between them — it also forces `secure`.
COOKIE_SAMESITE=lax

# Lets `pnpm seed` run against a production database. It replaces the catalogue, the customers and the order
# history, so it is never set by a deploy — the lab's demo site needs it once, by hand.
ALLOW_DEMO_SEED=false
