{
  "name": "@aib/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ALI_IWANBUY Gadgets REST API — Express 5 + MongoDB",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed/run.ts",
    "db:local": "node scripts/local-db.mjs",
    "settings:apply-defaults": "tsx src/scripts/apply-settings-defaults.ts"
  },
  "dependencies": {
    "@aib/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.20.1",
    "multer": "2.0.2",
    "nodemailer": "^7.0.13",
    "pdfkit": "0.17.2",
    "pino": "^9.14.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "0.17.4",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.2.3",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
