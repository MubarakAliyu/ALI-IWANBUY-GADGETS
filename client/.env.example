# ALI_IWANBUY Gadgets — storefront environment
# Copy to client/.env.local. Both values are optional in development and default to localhost.

# Where the Express API lives. Next.js rewrites /api and /uploads here, and Server Components call it directly.
API_ORIGIN=http://localhost:4000

# The site's own public origin, used for canonical URLs and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
